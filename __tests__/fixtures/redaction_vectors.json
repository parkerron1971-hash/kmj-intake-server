    },
    {
      "name": "uncredentialed URL host",
      "input": "https://aB3dE6gH9jK2mN5pQ8sT1vW4yZ7cF0iL.example.com/path",
      "expected": "https://aB3dE6gH9jK2mN5pQ8sT1vW4yZ7cF0iL.example.com/path"
