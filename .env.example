# kmj-intake-server — environment variables (set on Railway)
#
# Copy the NAMES you need; values live only on Railway, never in git.
# Most vars fail SOFT (the feature goes quiet) rather than crashing —
# which is harder to notice, so this file documents what breaks without
# each. "REQUIRED" = the app is meaningfully broken without it.

# ── Core: Supabase (REQUIRED — every authed endpoint 500s without these)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # service role — server-side DB, bypasses RLS. NEVER expose.
SUPABASE_ANON=                  # anon/public key (also shipped in the frontend bundle)
SUPABASE_JWT_SECRET=            # only if verifying HS256 JWTs locally

# ── AI (REQUIRED for Chief + assistant features)
ANTHROPIC_API_KEY=              # Chief, composer, agents. Lazy — missing = AI dead, app still boots.
OPENAI_API_KEY=                 # voice (TTS/Whisper) + embeddings + fallback brain

# ── Platform owner (REQUIRED — must match your sign-in email exactly, or
#    you can't mint an invite or reach Mission Control)
PLATFORM_OWNER_EMAIL=

# ── Spend + rate guards (optional — sensible defaults)
DAILY_SPEND_CAP_USD=50          # daily AI-$ circuit breaker
SPEND_GUARD=on                  # 'off' disables the breaker
RL_CHIEF_PER_MIN=30
RL_VOICE_PER_MIN=40
RL_PROXY_PER_MIN=60

# ── Email (Resend) — sends fail SILENTLY without the key
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mysolutionist.app
RESEND_WEBHOOK_SECRET=          # verifies the bounce/complaint webhook
EMAIL_UNSUB_SECRET=             # signs the one-click unsubscribe link
UNSUBSCRIBE_EMAIL=unsubscribe@mysolutionist.app

# ── SMS
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=             # live send path uses API-key auth (not the classic auth token)
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_AUTH_TOKEN=              # REQUIRED to verify inbound signatures (fails OPEN without it)
TELNYX_API_KEY=                 # legacy/alt SMS lane
TELNYX_PHONE_NUMBER=

# ── Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # subscription/billing webhook
STRIPE_PAYMENTS_WEBHOOK_SECRET= # payment-link/checkout webhook (falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PRICE_ID_STARTER=        # $79/mo   (locked 2026-07-21)
STRIPE_PRICE_ID_PROFESSIONAL=   # $199/mo
STRIPE_PRICE_ID_PRACTICE=       # $399/mo
STRIPE_PRICE_ID_STARTER_ANNUAL=       # $790/yr  (2 months free — optional)
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL=  # $1,990/yr
STRIPE_PRICE_ID_PRACTICE_ANNUAL=      # $3,990/yr
STRIPE_PRICE_ID_FOUNDER=        # $149/mo Founding Member (Professional, locked for life)
STRIPE_PRICE_ID_FOUNDER_ANNUAL= # $1,490/yr Founding Member (optional)
STRIPE_PRICE_ID_DEFAULT=        # legacy single-plan fallback (maps to professional)
FOUNDER_SEAT_LIMIT=50           # founding seats; cap enforced at checkout
BILLING_ENFORCE=off             # dormant; 'on' turns on plan enforcement

# ── Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_OAUTH_STATE_SECRET=        # HMAC key for OAuth CSRF state
META_FRONTEND_RETURN_URL=

# ── Meta Ads (growth arc Rung 2 — the platform's OWN ad measurement)
# Unset = fully dark: no pixel on the marketing site, no CAPI events,
# and the privacy page's advertising section stays hidden with it.
# Setting META_PIXEL_ID turns all three on together.
META_PIXEL_ID=                  # Events Manager → data sources → the pixel id
META_CAPI_ACCESS_TOKEN=         # Events Manager → pixel → Settings → Conversions API token
META_CAPI_TEST_CODE=            # optional; routes events to the Test Events tab while set
# Rung 3 — read-only spend on the Growth panel (unset = card hidden).
META_ADS_ACCESS_TOKEN=          # Business Manager → System User token with ads_read
META_AD_ACCOUNT_ID=             # the ad account ("act_123..." or bare digits)

# ── Plaid (bank connections)
PLAID_CLIENT_ID=
PLAID_ENCRYPTION_KEY=           # pgcrypto key for bank-token encryption

# ── Web Push
VAPID_PRIVATE_KEY=              # + VAPID_PUBLIC_KEY / VAPID_SUBJECT

# ── Build bridge (Chief → Claude Code)
GITHUB_TOKEN=                   # files @claude build issues; owner-gated dispatch

# ── Tokens / misc
CUSTOMER_TOKEN_SECRET=          # signs customer/booking tokens (REQUIRED — crashes if missing)
APP_DOMAIN=https://mysolutionist.app
CORS_ALLOWED_ORIGINS=*          # default '*' is deliberate (bearer auth, public embeds)
SENTRY_DSN=                     # error tracking; off unless set
