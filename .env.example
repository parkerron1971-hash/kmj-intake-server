# kmj-intake-server — environment variables (set on Railway)
#
# Copy the NAMES you need; values live only on Railway, never in git.
# Most vars fail SOFT (the feature goes quiet) rather than crashing —
# which is harder to notice, so this file documents what breaks without
# each. "REQUIRED" = the app is meaningfully broken without it.

# ── Core: Supabase (REQUIRED — every authed endpoint 500s without these)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # service role — server-side DB, bypasses RLS. NEVER expose.
SUPABASE_ANON=                  # anon/public key (also shipped in the frontend bundle)
SUPABASE_JWT_SECRET=            # only if verifying HS256 JWTs locally

# ── AI (REQUIRED for Chief + assistant features)
ANTHROPIC_API_KEY=              # Chief, composer, agents. Lazy — missing = AI dead, app still boots.
OPENAI_API_KEY=                 # voice (TTS/Whisper) + embeddings + fallback brain
CHIEF_NATIVE_WRITES=on          # 'off' = Chief's class-A writes go back to [ACTION:] tags only (chief_tool_loop)
CHIEF_AREAS=on                  # 'off' = Chief answers a church's lane logins about everything again, money included (chief_areas.py); 'on' keeps each to its areas
CHIEF_BANK_SEARCH=owner         # off | owner | on (owner when unset): Chief reads and totals bank rows (chief_transactions.py). owner = businesses the platform owner owns; off = Chief says it can't and points to the Transactions screen
HOUSING_ALLOWANCE=owner         # off | owner | on (owner when unset): a minister's housing allowance records, routes /housing-allowance and Chief's verbs (housing_allowance.py); off = 404 and Chief says they aren't switched on
STANDING_PERMISSIONS=on         # 'off' = no kind is ever sent on its own; every proposal waits for a tap (standing_permissions.py); also stops Chief approving marketing posts on a standing OK (B13): those go back to waiting for the owner
STANDING_RECALL_MINUTES=2       # the window to Stop a standing send
STANDING_ASK_AFTER=3            # approvals in a row before Chief asks once
STANDING_MONEY_CAP_USD=500      # an invoice above this still waits for a tap
POLICY_UNATTENDED_C=refuse      # an irreversible action (send, charge) runs unattended only on an owner instruction: a schedule, a confirmed workflow step, a Trust Track grant or a smart/full autopilot (policy_engine.py). 'allow' = the old record-only behaviour
CHIEF_WEEK=on                   # 'off' = no Monday report (chief_week.py); the Home card still reads live
OUTCOME_LEDGER=on               # 'off' = moves are not recorded, nothing retires, no digest (outcome_ledger.py)
PROPOSAL_LIFE=on                # 'off' = proposals neither expire nor remind (proposal_life.py)
PROPOSAL_EXPIRE_HOURS=48        # a filed proposal nobody approves is let go after this
PROPOSAL_REMIND_HOURS=6         # one reminder per proposal after this, in waking hours
CHIEF_ASSIGNMENTS=on            # 'off' = the assignments tick does nothing (chief_assignments.py). Same per-business switch as CHIEF_AGENT.
CHIEF_AGENT=on                  # 'off' = the standing agent tick does nothing (chief_agent.py). Per-business opt-in
                                # is settings.autonomy.agent_enabled (default off), via POST /agents/chief/agent/enable

# ── Platform owner (REQUIRED — must match your sign-in email exactly, or
#    you can't mint an invite or reach Mission Control)
PLATFORM_OWNER_EMAIL=

# ── Spend + rate guards (optional — sensible defaults)
DAILY_SPEND_CAP_USD=50          # daily AI-$ circuit breaker
SPEND_GUARD=on                  # 'off' disables the breaker
RL_CHIEF_PER_MIN=30
RL_VOICE_PER_MIN=40
RL_PROXY_PER_MIN=60

# ── Chief's two-track reply (docs/MODEL_ROUTER.md). All optional; defaults shown.
#    Without ANTHROPIC_API_KEY the router is off and the stream is the old stream.
CHIEF_CONTINUOUS_STREAM=on     # off restores serial headline and hold-on-unproved streaming
CHIEF_ROUTER=on                 # 'off' = no first track; still logs lane 'off' rows (ROUTER_LOG_WHEN_OFF)
CHIEF_ROUTER_FAST_LANE=on       # 'off' = Haiku never answers alone (openings still run)
CHIEF_ROUTER_OPENER=on          # 'off' = no Haiku opening (the local lead still holds the budget)
CHIEF_ROUTER_LOCAL_LEAD=on      # 'off' = no "Sure —" at the deadline (the budget can then be missed)
CHIEF_ROUTER_CACHE=on           # 'off' = no semantic cache for record-free answers
ROUTER_TTFT_BUDGET_MS=500       # the first-word SLO, measured from arrival (sse_middleware)
ROUTER_DEADLINE_MARGIN_MS=40    # the local lead goes out this long before the budget ends
ROUTER_FAST_MAX_SCORE=0.25      # complexity at/under this (and confident) → Haiku alone
ROUTER_FULL_MIN_SCORE=0.45      # at/over this → the full turn without asking the classifier
ROUTER_MIN_CONFIDENCE=0.7       # below this, route up
ROUTER_CLASSIFIER_TIMEOUT_MS=900
ROUTER_CACHE_TTL_S=86400
ROUTER_CACHE_SIMILARITY=0.8     # near-repeat threshold (numbers and negations must match exactly)
ROUTER_SLO_WINDOW_S=900         # p95 window for the alert
ROUTER_SLO_MIN_SAMPLES=20
ROUTER_SLO_ALERT_COOLDOWN_S=3600
ROUTER_KEEP_WARM=on             # keep the Anthropic connection open between turns
ROUTER_LOG_DB=on                # 'off' = log lines only, no model_route_log rows
ROUTER_LOG_WHEN_OFF=on
# The rail (docs/CHIEF_RAIL.md): after a full turn, money and calendar lookups are
# answered privately from a fresh read, proved, and compared with Chief's reply.
# Practice only: nothing is shown. No model calls. Rows go to chief_rail_practice.
CHIEF_RAIL=off                  # only 'practice' turns it on; unset or anything else is off
# CHIEF_MODEL_FAST / CHIEF_MODEL_ROUTE override the Haiku lanes (chief_models.py)
# Opus 5.5 controls: defaults below, except ATELIER_MODEL is the production override.
# CHIEF_MODEL_DEEP=claude-opus-5-5
# CHIEF_MODEL_INSIGHT=claude-opus-5-5
# CHIEF_EFFORT_DEEP=high
# CHIEF_EFFORT_INSIGHT=high
# SITE_SPEC_MODEL=claude-opus-5-5
# SITE_SPEC_EFFORT=medium
# ATELIER_MODEL=claude-opus-5-5
# ATELIER_EFFORT=medium
# Lane registry (lane_registry.py, Layer Two). Unset = the lane runs on Anthropic.
# Point one lane at an OpenAI-compatible endpoint, with its Claude model as the
# fallback on any failure; calls that use tools, thinking, caching or images stay
# on Claude regardless. The model needs a row in api_usage_logger pricing.
# CHIEF_PROVIDER_BACKGROUND=openai_compatible
# CHIEF_PROVIDER_MODEL_BACKGROUND=
# CHIEF_PROVIDER_URL_BACKGROUND=https://host/v1
# CHIEF_PROVIDER_KEY_ENV_BACKGROUND=NAME_OF_THE_ENV_VAR_HOLDING_THE_KEY
# Every lane carries client data, so the host must also be named in the privacy
# policy as a subprocessor and listed here (subdomains included). Unlisted or
# non-https = the lane stays on Claude. Change the policy first, then this list.
# CHIEF_SUBPROCESSOR_HOSTS=

# ── Calls: time to first audio (voice_metrics.py, whisper_proxy.py). Optional.
VOICE_TTFA_BUDGET_MS=1000       # the call SLO: turn end → first audible sample, at p95
VOICE_SLO_WINDOW_S=900
VOICE_SLO_MIN_SAMPLES=20
VOICE_SLO_ALERT_COOLDOWN_S=3600
VOICE_LOG_DB=on                 # 'off' = log lines only, no voice_turn_log rows
TTS_KEEP_WARM=on                # keep the speech providers' connection open between turns
TTS_PHRASE_CACHE=on             # serve short phrases (openers, leads) from memory

# ── Credit prices (every one is a dial; see pricing_config.py)
# Only the dials that are NOT at their shipped default need setting here.
# PRICE_VOICE_INPUT_PRICE is listed because /ai/whisper is 19.8% of the AI
# bill (370 calls / $9.12 over 2026-08-10..24) and charges 0 for it — the
# one dial most likely to move first. 0 = the shipped default.
PRICE_VOICE_INPUT_PRICE=0       # credits per Whisper transcription (a spoken turn's input half)

# ── Email (Resend) — sends fail SILENTLY without the key
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mysolutionist.app
RESEND_WEBHOOK_SECRET=          # verifies the bounce/complaint webhook
EMAIL_UNSUB_SECRET=             # signs the one-click unsubscribe link
UNSUBSCRIBE_EMAIL=unsubscribe@mysolutionist.app
INBOUND_EMAIL_DOMAIN=             # without it, replies to a Chief email go
                                  # to the practitioner's signature address
                                  # instead of back into the Inbox with the
                                  # (business, contact) context attached

# ── SMS
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=             # live send path uses API-key auth (not the classic auth token)
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PLATFORM_NUMBER=         # the shared number, E.164 (+1XXXXXXXXXX). Every send pins its sender to this until the business has its own number. Unset → Twilio picks from the pool (warned) — MUST be set before any dedicated number is provisioned.
TWILIO_AUTH_TOKEN=              # REQUIRED to verify inbound signatures (fails OPEN without it). Also the credential for number LIFECYCLE (search/buy/attach/release) — the API key is restricted to sending.
SMS_WEBHOOK_BASE=               # public host Twilio calls back (default: the Railway URL). Set on every purchased number as sms_url + status_callback.
SMS_NUMBERS_CAMPAIGN_CAP=       # default 49 — numbers a standard 10DLC campaign may hold before Twilio wants a number-pool request. Provisioning stops at the cap; warns at 80%.
SMS_NUMBER_RELEASE_GRACE_DAYS=  # default 14 — a released private number stays recoverable this long before the hourly sweep hands it back to Twilio.
TELNYX_API_KEY=                 # legacy/alt SMS lane
TELNYX_PHONE_NUMBER=

# ── Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # subscription/billing webhook
STRIPE_PAYMENTS_WEBHOOK_SECRET= # payment-link/checkout webhook (falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PUBLISHABLE_KEY=         # the platform's pk_live_ (or pk_test_ with a test secret). Set = the give page's payment form opens on the page itself (embedded Checkout on the church's account), and Operate > Payments offers "Set up Stripe here" (Stripe's signup form in the app). Unset, or the other mode from STRIPE_SECRET_KEY = Give goes to checkout.stripe.com and back, as before.
STRIPE_GIVING_PMC=              # the platform's giving payment set: a Connect parent payment method configuration (pmc_...) with Cards, Apple Pay, Google Pay, Link and ACH Direct Debit on, everything else off. Set = gift checkouts use it, and a church can turn on "Pay with: bank account". Unset = gifts use the platform default set (card and Link only where GIVING_SERVICES is on; no bank choice).
GIVING_SERVICES=owner           # off | owner | on (owner when unset): ways to give (Cash App, Zelle, ... on the give page and the treasurer's menu), card-or-bank gift checkouts with no pay-later (giving_ways.py), and the service counts. owner = the platform church
# Pin the Stripe API version. UNSET = the account's own version, which
# is what every call has always used. Worth pinning once you have
# verified a checkout against it — a wrong string 400s every call.
STRIPE_API_VERSION=            # e.g. 2025-06-30.basil
STRIPE_PRICE_ID_STARTER=        # $79/mo   (locked 2026-07-21)
STRIPE_PRICE_ID_PROFESSIONAL=   # $199/mo
STRIPE_PRICE_ID_PRACTICE=       # $399/mo
STRIPE_PRICE_ID_STARTER_ANNUAL=       # $790/yr  (2 months free — optional)
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL=  # $1,990/yr
STRIPE_PRICE_ID_PRACTICE_ANNUAL=      # $3,990/yr
STRIPE_PRICE_ID_FOUNDER=        # $99/mo Founding Member (Professional, own 6,000-credit tank, locked for life)
STRIPE_PRICE_ID_FOUNDER_ANNUAL= # $990/yr Founding Member (optional)
STRIPE_PRICE_ID_FOUNDER_LEGACY= # comma list of RETIRED founder price ids whose seats still count toward the cap (defaults to the pre-2026-09-04 pair in stripe_billing)
STRIPE_PRICE_ID_DEFAULT=        # legacy single-plan fallback (maps to professional)
FOUNDER_SEAT_LIMIT=50           # founding seats; cap enforced at checkout
# Where Stripe returns the customer's browser. All three have working
# defaults (mysolutionist.app/billing/{success,cancel,done}, served by
# stripe_billing.py) — set them only to point somewhere else.
STRIPE_SUCCESS_URL=             # default https://mysolutionist.app/billing/success
STRIPE_CANCEL_URL=              # default https://mysolutionist.app/billing/cancel
STRIPE_PORTAL_RETURN_URL=       # default https://mysolutionist.app/billing/done
BILLING_ENFORCE=off             # dormant; 'on' turns on plan enforcement
# Free trial on a FIRST subscription. The marketing site quotes this SAME
# number ("N days free"), so changing it here changes the page too. 0
# disables the trial, and the copy adapts rather than saying "0 days free".
BILLING_TRIAL_DAYS=7
# The trial tank. A trial ends on whichever runs out first — these
# credits or BILLING_TRIAL_DAYS. Flat across every tier on purpose:
# a bigger tank on the dearer plan would just be a reason to trial
# Solutionist and downgrade. 1,000 = ~83 Chief turns (~$8 of cost).
PRICE_TRIAL_CREDITS=1000
PRICE_TRIAL_BUILD_FREE=1       # trial's FIRST site build is free; 0 charges it
# The no-card trial (no_card_trial.py): a new business starts its trial
# with no card and the smaller tank below; adding a card (same trial end
# date) lifts it to PRICE_TRIAL_CREDITS. Texts, phone numbers, bulk email
# and a second site build wait for the card. Only starts while
# BILLING_ENFORCE is on. 0 sends new signups back to the card paywall.
PRICE_NO_CARD_TRIAL=1
PRICE_TRIAL_CREDITS_NO_CARD=500  # free build + ~41 Chief turns (~$6-7 worst case)
NO_CARD_TRIAL_PLAN=professional  # the plan a no-card trial shows (features)
PRICE_NO_CARD_FREE_WORKSPACE=1  # an ended no-card trial keeps the app without AI; 0 = the full wall
LIMIT_NO_CARD_FREE_BUILDS_PER_DAY=10  # free no-card site builds a day, platform-wide; 0 = none
# Lifecycle emails to the account holder: welcome (first business),
# trial ending soon, trial ended. Once per business each, stamped in
# businesses.settings.lifecycle_emails. The trial pair stays quiet while
# BILLING_ENFORCE is off — nothing locks, so there is nothing to warn about.
LIFECYCLE_EMAILS=on            # 'off' silences lifecycle sends and reminders
LIFECYCLE_TRIAL_ENDING_DAYS=2  # "ends soon" goes out at this many days left
# The setup brief (setup_brief.py): in a business's launch window, a
# morning with nothing to report gets ONE next setup step instead of
# no brief at all. No model call. 'off' = the old skip-when-empty.
SETUP_BRIEF=on
SETUP_BRIEF_WINDOW_DAYS=14     # days from day one it runs while setup is unfinished (7-60)
# The doors. Empty/off = anyone can create a business and subscribe.
# 'on' re-gates business creation to invited + grandfathered users
# (docs/LAUNCH_ACCESS_CONTROL.md). Reversible from Railway, no deploy.
LAUNCH_INVITE_ONLY=off
# Kinds of practice no new business may be opened for (vertical_scope.py).
# Unset = therapist,health_care (paused 2026-10-12: no BAAs). "none" reopens.
# PAUSED_VERTICALS=therapist,health_care

# ── Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_OAUTH_STATE_SECRET=        # HMAC key for OAuth CSRF state
META_FRONTEND_RETURN_URL=

# ── Meta Ads (growth arc Rung 2 — the platform's OWN ad measurement)
# Unset = fully dark: no pixel on the marketing site, no CAPI events,
# and the privacy page's advertising section stays hidden with it.
# Setting META_PIXEL_ID turns all three on together.
META_PIXEL_ID=                  # Events Manager → data sources → the pixel id
META_CAPI_ACCESS_TOKEN=         # Events Manager → pixel → Settings → Conversions API token
META_CAPI_TEST_CODE=            # optional; routes events to the Test Events tab while set
# Rung 3 — read-only spend on the Growth panel (unset = card hidden).
META_ADS_ACCESS_TOKEN=          # Business Manager → System User token with ads_read
META_AD_ACCOUNT_ID=             # the ad account ("act_123..." or bare digits)

# ── Plaid (bank connections)
PLAID_CLIENT_ID=
PLAID_ENCRYPTION_KEY=           # pgcrypto key for bank-token encryption

# ── Web Push
VAPID_PRIVATE_KEY=              # + VAPID_PUBLIC_KEY / VAPID_SUBJECT

# ── Build bridge (Chief → Claude Code)
GITHUB_TOKEN=                   # files @claude build issues; owner-gated dispatch

# ── Agent connector (MCP) — docs/AGENT_CONNECTOR.md
MCP_ENABLED=on                  # 'off' = the whole surface (and OAuth) answers 503; the kill switch
MCP_TOKEN_SECRET=               # signs Agent Access keys; falls back to CUSTOMER_TOKEN_SECRET. Set it,
                                # so rotating it revokes every agent key WITHOUT breaking booking links
MCP_PUBLIC_BASE_URL=            # the public origin in the OAuth discovery docs; defaults to Railway prod
RL_MCP_PER_MIN=20               # per-caller calls/min on /mcp; fails CLOSED
RL_AGENT_SITE_PER_MIN=60        # per-IP calls/min on /public/agent/* (a customer's agent reading a site); fails CLOSED

# ── Action ledger: anchoring + auditor links — docs/ACTION_LEDGER.md
# Only a Merkle root of row hashes is ever published, never business data.
LEDGER_ANCHOR_PROVIDERS=        # comma list: opentimestamps, hedera. Unset → LEDGER_ANCHOR_PROVIDER, then
                                # 'local' = publishes NOTHING (anchors are receipts of nothing public)
LEDGER_ANCHOR_PROVIDER=         # legacy single-provider form of the line above
LEDGER_ANCHOR_SCHEDULE=on       # 'off' = no automatic anchoring; only the owner's manual POST /audit/anchor
LEDGER_ANCHOR_INTERVAL_HOURS=6  # how often the anchor sweep runs
LEDGER_ANCHOR_MAX_PER_TICK=25   # businesses anchored per sweep
LEDGER_ANCHOR_UPGRADE_BATCH=25  # pending Bitcoin proofs checked per hourly upgrade tick
HEDERA_ACCOUNT_ID=              # all three required to anchor to Hedera; a missing one refuses by
HEDERA_PRIVATE_KEY=             # name and writes no receipt (the hedera provider fails, others still run)
HEDERA_TOPIC_ID=
HEDERA_NETWORK=testnet          # ONLY 'mainnet' counts as independent; testnet proofs are wiped on reset
AUDITOR_LINK_SECRET=            # signs auditor links + the ledger unlock; falls back to MCP_TOKEN_SECRET,
                                # then CUSTOMER_TOKEN_SECRET. Set it, so rotating it revokes auditor links alone
PUBLIC_API_BASE=                # the host auditor links point at; defaults to Railway prod

# ── Tokens / misc
CUSTOMER_TOKEN_SECRET=          # the ROOT for customer/booking links (REQUIRED — crashes if missing).
                                # Each business signs with a key derived from it (customer_token.derive_key);
                                # rotating it still invalidates every link, so treat it as permanent.
RL_BOOKING_CHECKOUT_PER_HOUR=20 # anon Stripe Checkout sessions per IP; strict
RL_WAITLIST_PER_HOUR=10         # anon waitlist joins per IP; strict
RL_DOCUMENT_CHECK_PER_MIN=20    # per-IP hash lookups/min on /public/verify/document; strict (fails CLOSED)
RL_SMS_OPT_IN_PER_HOUR=10       # web-form SMS consents per IP (per phone too); strict
RL_DAILY_JOIN_PER_HOUR=10       # a church's /daily devotional text sign-ups per IP; strict
RL_TRACK_PER_MIN=240            # traffic beacon per IP; fails open
RL_BOOKING_ANON_PER_HOUR=10     # booking widget anon routes per IP (config, book, fresh link); strict
RATE_LIMIT_SHARED=on            # 'off' = strict buckets stay per-process (skip the rate_take RPC)
APP_DOMAIN=https://mysolutionist.app
CORS_ALLOWED_ORIGINS=*          # default '*' is deliberate (bearer auth, public embeds)
SENTRY_DSN=                     # error tracking; off unless set

# Native Academy classes (Railway backend only; never VITE_ variables).
LIVEKIT_URL=                    # wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Reuses SUPABASE_URL, SUPABASE_ANON, SUPABASE_SERVICE_ROLE_KEY above.

# Our own stream relay (stream_relay_router.py, stream_relay/ on a droplet).
# All seven switch it on; without them the church's Stream panel stays
# hidden and the relay's routes refuse every stream (fail closed).
STREAM_RELAY_SECRET=           # shared with the relay server's .env
STREAM_DEST_ENCRYPTION_KEY=    # Fernet key; encrypts churches' YouTube/Facebook keys, signs managers' links
STREAM_INGEST_URL=             # rtmps://stream.<domain>:443/live — what a church types as the server (must be rtmps)
# The PRIVATE media bucket the relay records into. This server only reads
# it, to hand players short-lived signed links: use an R2 token with
# Object Read on that bucket only (the droplet has its own write token).
STREAM_R2_ENDPOINT=            # https://<account id>.r2.cloudflarestorage.com
STREAM_R2_BUCKET=              # solutionist-media
STREAM_R2_ACCESS_KEY_ID=
STREAM_R2_SECRET_ACCESS_KEY=

# Customer-device AI pilot. Apply APPLY-2026-09-11-connected-ai.sql first.
# Both values AND existing agent_connector_write entitlement are required.
CONNECTED_AI_ENABLED=off
CONNECTED_AI_PILOT_BUSINESSES=  # comma-separated approved business UUIDs

# Chief's computer PR1: independent Fernet key, server secret storage ONLY.
# Generate once with cryptography.fernet.Fernet.generate_key(). Do not paste a
# real key in this file, frontend variables, logs, SQL, or a PR. Missing/invalid
# configuration fails closed (500); there is no plaintext or TIN-key fallback.
# Back up securely: replacing or losing this key makes saved logins unreadable.
# This does not enable errands or card storage. See docs/CHIEF_COMPUTER.md.
VAULT_ENCRYPTION_KEY=
# Enable only after all six arc PRs, runtime/completion migrations and vault key are live.
ERRANDS_ENABLED=off
# Optional pilot list: comma-separated business UUIDs. When set, ERRANDS_ENABLED=on
# runs Chief's computer only for these businesses; empty means every business.
ERRANDS_BUSINESS_IDS=
# Solutionist's own marketing only. Never expose this key to the frontend or tenants.
# Create in Buffer > Settings > API. Apply the platform-marketing SQL migration,
# then use Mission Control > Growth to select the organization and channels.
BUFFER_API_KEY=
# Explicit deployment switch. The calendar also has a persistent pause control.
BUFFER_PUBLISHING=off
# The marketing desk for every business (Grow → Marketing). ON when unset or
# empty (open to every business since 2026-10-08): the worker sends approved
# posts through Post for Me (every minute) and watches how each went (every 5
# minutes), telling the owner once per problem. It also needs
# POST_FOR_ME_API_KEY and POST_FOR_ME_PILOT_BUSINESSES on the worker (missing
# either, the sender claims nothing; a business outside the pilot list has its
# posts held, not failed). Nothing is sent without the owner's approval (or a
# standing OK the owner granted on the Solutionist plan).
# KILL SWITCH: MARKETING_DESK_PUBLISHING=off (also false, no, 0) on the worker
# AND the web: approved posts wait (once it is back on, any whose six-hour
# window passed fail as "time passed"), "Post now" on the desk refuses, and no
# delivery is checked or announced.
MARKETING_DESK_PUBLISHING=
# Chief's Thursday marketing work for every business (Grow → Marketing):
# unset or empty = EVERY business (open to all since 2026-10-08; * or on say
# the same) | a comma-separated list of business ids = only those | off = nobody
# (the KILL SWITCH; also false, no, 0; a value with no business id in it
# switches nobody on). Read on the PROCESS_ROLE=worker service AND the web
# service (the web's "Suggest a post now" and Chief's desk verbs refuse for a
# business it does not cover). For a business it covers, whose desk's weekly
# plan is on (marketing_desks.plan_enabled: on when the business has no saved
# desk row; an owner who turns it off stays off), which has a connected
# account, the posting pilot on and a plan: Starter, Solo and Booked get one
# suggested post a week (a draft, never sent until the owner approves it):
# Thursday from 7:00 local (plus up to two hours, spread per business), Monday
# to Wednesday only for a week never planned, never overnight. One small
# caption call each (about 1-2 cents, metered) and a free flyer. Professional
# and Practice get Chief's weekly plan (B9): five drafts a week, each with a
# Creative Director flyer included in the plan (no credits charged; about $1.35
# a business-week in provider cost, up to about $2.50 when every flyer takes
# its repair, metered); a Boss chair business with a live calendar gets the
# open-chairs week (B11). Solutionist's own business stays out while its
# marketing runs on the Mission Control desk (MC_MARKETING_SUITE, below).
# MARKETING_DESK=off: nothing is written, and the owner's "Suggest a post now"
# says it is not on.
MARKETING_DESK=
# The most businesses the hourly suggestion run writes for in one tick
# (default 10, at most 100). The rest wait for the next hour. Whatever this
# says, the run stops for the hour once today's platform AI spend reaches 60% of
# DAILY_SPEND_CAP_USD, and skips any business over its own daily ceiling. A
# weekly plan also waits while its estimated $2.55 (with what is already on its
# way) would cross that 60%.
MARKETING_MAX_PER_TICK=10
# How many weekly-plan flyers may be in progress at once across every business
# (default 10, two weeks; at least 5, at most 50). A week starts only when its
# five fit; the rest wait for a later hour. Each flyer is a Creative Director
# design running on the worker. A flyer not ready 20 minutes after it started
# leaves its post words only (Instagram left out), so a week is never held up.
MARKETING_DESIGNS_AT_ONCE=10
# Mission Control's Marketing desk on the marketing suite (B15, platform_suite.py):
# off (default) = the Buffer desk exactly as before. on = Solutionist's own
# business gets the desk every business has (/platform/marketing/suite/*, the
# platform owner only), posts go out through Post for Me from its own connected
# accounts, its weekly plan is the suite's (the old Thursday job does nothing),
# and nothing new goes to Buffer: posts approved there before the switch still
# go out (watch GET /platform/marketing/drain reach 0, then BUFFER_PUBLISHING=off).
# Set it on the web AND the worker. It also needs a valid PLATFORM_BUSINESS_ID, the
# platform business in POST_FOR_ME_PILOT_BUSINESSES (or *), and
# MARKETING_DESK_PUBLISHING not off for its posts to send.
MC_MARKETING_SUITE=off
# businesses.id of Solutionist's own business (the row Mission Control's Money &
# Website set up: settings.platform_books true, owned by PLATFORM_OWNER_EMAIL).
# The server checks it (its row says platform_books AND its owner is the
# PLATFORM_OWNER_EMAIL user) before the suite counts as on. Unset or not that
# business, with MC_MARKETING_SUITE=on: the Buffer desk keeps working as before,
# an error is logged, and /platform/marketing/suite/status and /drain say why.
# Only this id gets the platform's profile, numbers and the autopilot level
# whatever its billing row says; nothing a request sends can.
PLATFORM_BUSINESS_ID=

# Durable Chief builds. Apply supabase/APPLY-2026-09-18-chief-builds.sql first.
# off = existing behavior; on = owner-only deterministic event/form/flyer/site builds.
CHIEF_BUILDS=off
# A practitioner's flyer build uses the Creative Director (plan, draw, check, one
# repair; 30 credits a design). off = the older single image call. Default on.
PRACTITIONER_CREATIVE_DIRECTOR=on

# Jev event workflow selection (Railway web + scheduler; never VITE_).
# Direct active integration: high-confidence choices replace the first planning
# call. Chief still looks up facts and uses existing execution/approval controls.
CHIEF_DECISIONS=off
CHIEF_DECISIONS_PROVIDER=vercel  # vercel or typesafe; no automatic provider switch
CHIEF_DECISIONS_BUSINESSES=     # comma-separated business UUIDs; empty = none
AI_GATEWAY_API_KEY=             # Vercel AI Gateway key (default provider)
TYPESAFE_API_KEY=               # only needed with provider=typesafe
CHIEF_DECISIONS_TIMEOUT_SECONDS=2
CHIEF_DECISIONS_MIN_CONFIDENCE=0.85

# Optional active page/blocker guidance for approved Chief Computer jobs.
# Requires CHIEF_DECISIONS=on and the same business allowlist/key above.
CHIEF_COMPUTER_DECISIONS=off

# Solutionist Wallet: customer-owned confidential Link OAuth; no live spending.
# Apply 2026-09-23-link-wallet migration before configuration. See docs/LINK_WALLET.md.
LINK_WALLET_ENABLED=false
LINK_WALLET_CLIENT_ID=
LINK_WALLET_CLIENT_SECRET=
LINK_WALLET_PUBLISHABLE_KEY=
LINK_WALLET_ENCRYPTION_KEY=

# Lane buyer private pilot; personal credential is bound to one owner and business.
# Apply 2026-09-24-lane-wallet first. See docs/LANE_PILOT_SETUP.md.
LANE_PILOT_ENABLED=false
LANE_PILOT_BUSINESS_ID=
LANE_PILOT_USER_ID=
LANE_PILOT_API_KEY=
LANE_WALLET_ENCRYPTION_KEY=
LANE_PURCHASES_ENABLED=false
LANE_CHECKOUT_ENABLED=false

# Owner campaign social metrics. Apply 2026-09-26-marketing-campaigns first.
# Enable on the scheduler worker for hourly bounded reads; each post at most daily.
MARKETING_METRICS_ENABLED=off

# Canonical app destination for transactional email links.
APP_BASE_URL=https://system.mysolutionist.app

# Continuous ElevenLabs input/audio stream; off retains sentence HTTP speech.
CHIEF_ELEVEN_STREAM=on
# Flash for conversation; set eleven_turbo_v2_5 to restore the prior model.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Featured voices (Grace, Elijah, Jessica, Reed — whisper_proxy
# INWORLD_VOICES), included with every plan. The Basic credential from
# Inworld's dashboard; unset hides the voices and any saved choice speaks
# as Nova. Grace and Elijah live in this key's workspace.
INWORLD_API_KEY=
# inworld-tts-2-flash is the included tier; inworld-tts-2 costs ~2x.
INWORLD_TTS_MODEL=inworld-tts-2-flash

# Outside calendars (outside_calendar.py): connected private iCal feeds are
# re-read every 15 minutes by the scheduler worker. Default on; "off" stops
# the scheduled re-read only (connect and Sync now still work). Without the
# 2026-09-26 calendar-feeds migration the feature reports "not set up yet".
CALENDAR_FEEDS_SYNC=on

# Direct, read-only Chief appointment checks. Off restores general conversation routing.
# Final checks read current availability; voice preparation never reserves a slot.
CHIEF_AVAILABILITY_CHECK=on
# Apply supabase/APPLY-2026-10-03-chief-event-delivery.sql to the shared database first.
# Switch web and scheduler together after draining old event runs.
CHIEF_DURABLE_EVENTS=off

# Square connection pilot: disabled until migration + sandbox acceptance. Backend only.
SQUARE_ENABLED=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_APPLICATION_SECRET=
SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_APPLICATION_SECRET=
SQUARE_TOKEN_ENCRYPTION_KEY=
SQUARE_REDIRECT_URI=https://kmj-intake-server-production.up.railway.app/connect/square/callback
SQUARE_APP_RETURN_URL=https://system.mysolutionist.app
# Comma-separated auth.users IDs; no implicit access for other owners.
SQUARE_PILOT_OWNER_IDS=
# Outreach journeys (outreach_journeys.py, 2026-10-09): the review ask,
# win-back, rebook and birthday notes a business switches on. off: the
# sweep sends nothing (the owner's switches still save).
JOURNEYS=on
# Journey TEXTS (marketing) stay off until the shared number's 10DLC
# registration covers marketing (Kevin's step in Twilio); until then every
# journey note goes by email. on: a note goes by text only to someone who
# ticked "texts about offers" when they booked (sms_consents
# source=booking_marketing), never after STOP.
JOURNEY_TEXTS=off
# The devotional a day at a time (devotional_daily.py): /daily on a church's
# own address, its text sign-up (the form, or DAILY to the church's own
# number) and the 7:30 PM Eastern text of tomorrow's day. Which churches:
# comma-separated business ids; unset = Love City only; * = every church;
# off = none (/daily 404s). DEVOTIONAL_DAILY=off stops the evening texts alone.
# DEVOTIONAL_DAILY_BUSINESSES=009e9a2c-3e81-4bfc-a92a-205a8806aa99
# DEVOTIONAL_DAILY=on

# Square trial calendar: apply APPLY-2026-10-11-square-booking-sync.sql first.
# Public access is never implied: the owner allowlist remains mandatory.
SQUARE_BOOKING_SYNC_ENABLED=false
# Keep false until sandbox security checks AND consenting real-business pilot are reviewed.
SQUARE_PRODUCTION_PILOT_APPROVED=false

# The church section of the public site (church_site.py): /churches and its
# seven product pages, each lit in its own colour. On when unset: the section
# serves and joins the sitemap. off (the rollback): /churches goes back to the
# home page's church edition and /churches/<page> goes to the catch-all.
# CHURCH_SITE=off
# Help requests (church_help.py): a church's benevolence fund, its limit, a
# keeper's yes above it, and the record of help given. off | owner | on;
# owner (the default) shows it to the platform owner alone until a Thursday.
# Needs supabase/APPLY-2026-10-27-church-help.sql; until then it stays hidden.
# CHURCH_HELP=on
# Check requests (church_checks.py): a volunteer's "Get paid back" with a
# receipt photo under Serve in the member app, the money levels' yeses (below),
# budgets by ministry, and paid by check or transfer into the books.
# off | owner | on; owner (the default) shows the office page to the platform
# owner alone, and the member side only in the platform owner's preview of the
# member app, until a Thursday. Needs supabase/APPLY-2026-10-27-church-checks.sql;
# until then it stays hidden.
# CHURCH_CHECKS=on
# The money levels for check requests (church_money_levels.py): the treasurer
# says yes to every amount, the pastor too from $500, a board member too over
# $2,500 or past a ministry's budget; each a different person, never the one
# who asked. on (the default; any value but off reads as on) | off, which goes
# back to one limit ($250 unless set) and a Giving keeper's yes above it.
# Needs supabase/APPLY-2026-10-28-church-money-levels.sql: before it, a yes
# answers 503.
# CHURCH_MONEY_LEVELS=on
# The church register (church_register.py): baptisms, dedications, weddings,
# funerals and membership dates, with certificates. off | owner | on; owner
# (the default) shows it to the platform owner alone until a Thursday.
# Needs supabase/APPLY-2026-10-27-church-register.sql; until then it stays hidden.
# CHURCH_REGISTER=on
# The roll (church_roll.py): a church's People page in one read (people, their
# last 8 Sundays, families, groups, serving, This week). off | owner | on;
# owner (the default) shows it to the platform owner alone until a Thursday.
# No migration. The app's church/roll/rollRollout.ts is the other half.
# CHURCH_ROLL=on
# Board & minutes (church_board.py): a church's boards (elders, deacons), their
# meetings, attendance with quorum, minutes and the decisions log. off | owner |
# on; owner (the default) shows it to the platform owner alone until a
# Thursday. Needs supabase/APPLY-2026-10-27-church-board.sql; until then it
# stays hidden.
# CHURCH_BOARD=on
# The live room (member_portal_live.render_room): the member app's /my/live
# redesign (video pinned, chat filling the screen, Prayer and Give over the
# chat, quick replies, hearts). off | owner | on; on (the default) is every
# member's; owner shows it only in the owner's preview of the member app; off
# is the page before it (the way back). Needs
# supabase/APPLY-2026-10-30-live-hearts.sql (applied; the live page reads
# live_sessions.hearts whatever this says).
# LIVE_ROOM=off
# The Reports pack (church_reports.py): Home › Reports, the year's numbers a
# church is asked for (attendance, members, groups, serving, giving, care,
# events), the printed annual report and a CSV for the denomination. off |
# owner | on; owner (the default) shows it to the platform owner alone until a
# Thursday. No migration: it reads tables that already exist, and a source
# that isn't set up yet shows "—" with the reason.
# CHURCH_REPORTS=on
# The Monday leaders note (church_leaders_note.py): the office's weekly email
# to the All group leaders room (this week, what's needed, one win), drafted
# from the church's own calendar and Sunday teams, once a week. off | owner |
# on; owner (the default) shows it to the platform owner alone until a
# Thursday. No migration: the last send is kept in businesses.settings.
# CHURCH_LEADERS_NOTE=on
# My tasks for leaders (church_leader_tasks.py): Tasks' Hand to lists the
# church's leaders (the All group leaders room) under the office logins; a
# task handed to one shows on their member app's Lead tab with a Done button,
# they're emailed within the hour, and one past due goes up once (the
# church's morning) to whoever they answer to. off | owner | on; owner (the
# default) opens the office side to the platform owner alone, and the Lead
# tab and the emails to the platform owner's own church, until a Thursday.
# The hourly sweep runs on the worker: set it on BOTH kmj-intake-server and
# kmj-intake-worker. Needs supabase/APPLY-2026-10-27-leader-tasks.sql; until
# then it stays hidden and the sweep is quiet.
# CHURCH_LEADER_TASKS=on
# The coaches and consultants section (coach_site.py): /coaches (and
# /consultants) plus seven product pages, the same way. On when unset.
# off (the rollback): both go back to the home page's coaches edition and
# /coaches/<page> goes to the catch-all.
# COACH_SITE=off
# ChurchSavvy's own site (the Sunday screens partner). Unset: the partner band
# on /churches shows with no button, and the footer leaves the link out.
# Must be an https:// address.
# CHURCHSAVVY_URL=https://churchsavvy.example
# Paid sign-ups for church events, with a waitlist (church_event_signups.py).
# off | owner | on, owner when unset: only a church the platform owner owns
# can price an event or take a sign-up (the app shows the office controls to
# the platform owner only until its own Thursday flip). on: every church.
# off: no prices; an event set up earlier says "sign-ups aren't open online".
# CHURCH_PAID_SIGNUPS=owner
# Per-network limits on the public sign-up (strict, shared across replicas).
# RL_EVENT_SIGNUP_PER_10MIN=12
# RL_EVENT_SIGNUP_READ_PER_10MIN=60
