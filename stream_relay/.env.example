# Copy to .env on the droplet (chmod 600). Never commit the real one.
STREAM_HOST=stream.mysolutionist.app   # the DNS name churches stream to (its certificate is made for it)
BACKEND_URL=https://kmj-intake-server-production.up.railway.app
STREAM_RELAY_SECRET=          # the same value as Railway's STREAM_RELAY_SECRET
R2_ENDPOINT=                  # https://<account id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=             # an R2 token with Object Read & Write on the media bucket only
R2_SECRET_ACCESS_KEY=
R2_BUCKET=solutionist-media   # PRIVATE: no r2.dev address, no custom domain
GRACE_S=600                   # how long a dropped stream may take to come back
# Limits (defaults shown) — so one church can't take the droplet:
# MAX_STREAMS=4  DISK_RESERVE_GB=2  SPOOL_MAX_GB=6  MAX_RECORD_S=21600  MAX_INGEST_MBPS=25
# How long a key the backend confirmed keeps working while it can't be reached:
# OFFLINE_GRANT_S=691200 (8 days: a weekly service survives a Railway outage)
