# Copy to .env on the droplet (chmod 600). Never commit the real one.
BACKEND_URL=https://kmj-intake-server-production.up.railway.app
STREAM_RELAY_SECRET=          # the same value as Railway's STREAM_RELAY_SECRET
R2_ENDPOINT=                  # https://<account id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=             # an R2 API token limited to the media bucket
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                    # the bucket behind MEDIA_PUBLIC_BASE
GRACE_S=600                   # how long a dropped stream may take to come back
