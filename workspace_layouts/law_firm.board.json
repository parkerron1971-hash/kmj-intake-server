{
  "schema_version": 1,
  "archetype": "law_firm",
  "label": "Law Firm",
  "vertical": "lawyer",
  "identity": "lawyer",
  "terminology": {
    "client": {
      "value": "Client",
      "origin": "preset"
    },
    "clients": {
